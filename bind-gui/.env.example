# Security: Generate a strong secret using: openssl rand -base64 32
AUTH_SECRET=

# Admin credentials for NextAuth.js authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Path to BIND configuration directory (usually /app/bind/config)
CONFIG_DIR=/app/bind/config
# URL where the NextAuth.js authentication will be available (e.g., http://localhost:3001)
NEXTAUTH_URL=